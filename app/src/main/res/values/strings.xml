    <string name="onboarding_trigger_pixel">Settings → System → Gestures → Quick Tap → Open app → LibreShot. Double-tap the back of the phone to capture.</string>
    <string name="onboarding_trigger_generic">This device has no Quick Tap gesture. Add the LibreShot tile to Quick Settings (edit the tiles panel) and tap it to capture.</string>
