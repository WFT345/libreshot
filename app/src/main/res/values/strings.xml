    <string name="onboarding_title">LibreShot</string>
    <string name="onboarding_tagline">iOS-style screenshots: peek, edit, copy, gone.</string>
    <string name="onboarding_a11y_title">Enable the accessibility service</string>
    <string name="onboarding_a11y_body">LibreShot uses Android’s accessibility screenshot API because it’s the only way to take a screenshot without saving a file. The service does not read screen content, does not see your keystrokes, and only acts when you trigger a capture.</string>
